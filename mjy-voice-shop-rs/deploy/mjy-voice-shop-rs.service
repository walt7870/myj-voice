[Unit]
Description=MJY Voice Shop Rust Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# This template is rendered by scripts/deploy-jd.sh before installation.
WorkingDirectory=@@APP_DIR@@
EnvironmentFile=-@@APP_DIR@@/.env
Environment=HOST=0.0.0.0
Environment=PORT=@@PORT@@
Environment=RUST_LOG=info
ExecStart=@@APP_DIR@@/mjy-voice-shop-rs
Restart=always
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
